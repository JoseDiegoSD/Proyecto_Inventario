<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="720.0" prefWidth="1000.0" spacing="20.0" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.unison.controllers.LoginController">
   <children>
      <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" styleClass="card">
         <children>
            <Label styleClass="title" text="Inventario IA" />
            <Label styleClass="subtitle" text="Inicia sesión para continuar" />
            <TextField fx:id="txtUsuario" promptText="Nombre de Usuario" />
            <PasswordField fx:id="txtPassword" promptText="Contraseña" />
            <Label fx:id="lblError" styleClass="error-label" visible="false" />
            <Button fx:id="btnLogin" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" styleClass="button-primary" text="Iniciar Sesión" />
         </children>
      </VBox>
   </children>
</VBox>
