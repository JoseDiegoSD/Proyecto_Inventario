<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.unison.controllers.AlmacenesController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Gestión de Almacenes" />
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefWidth="300.0" spacing="15.0" styleClass="card">
               <children>
                  <Label styleClass="subtitle" text="Detalles del Almacén" />
                  <TextField fx:id="txtNombre" promptText="Nombre del Almacén" />
                  <TextField fx:id="txtUbicacion" promptText="Ubicación" />
                  <Label fx:id="lblError" styleClass="error-label" visible="false" />
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#guardarAlmacen" styleClass="button-primary" text="Guardar" />
                        <Button mnemonicParsing="false" onAction="#limpiarFormulario" styleClass="button-secondary" text="Limpiar" />
                     </children>
                  </HBox>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminarAlmacen" style="-fx-background-color: #FF4C4C; -fx-text-fill: white; -fx-background-radius: 25; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;" text="Eliminar Seleccionado" />
               </children>
            </VBox>
            <TableView fx:id="tablaAlmacenes" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
                  <TableColumn fx:id="colUbicacion" prefWidth="150.0" text="Ubicación" />
                  <TableColumn fx:id="colUltimaMod" prefWidth="150.0" text="Última Modificación" />
              </columns>
            </TableView>
         </children>
      </HBox>
   </children>
</VBox>
