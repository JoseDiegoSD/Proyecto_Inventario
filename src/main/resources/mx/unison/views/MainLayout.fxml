<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" prefHeight="720.0" prefWidth="1000.0" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.unison.controllers.MainLayoutController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-border-color: transparent transparent #E0E0E0 transparent; -fx-border-width: 1;">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Label styleClass="title" style="-fx-font-size: 24px;" text="Inventario IA" />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="lblBienvenida" styleClass="subtitle" text="Bienvenido, Usuario" />
                  <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-margin-left: 20px;" styleClass="button-secondary" text="Cerrar Sesión">
                     <HBox.margin>
                        <Insets left="20.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefHeight="200.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-border-color: transparent #E0E0E0 transparent transparent; -fx-border-width: 1;">
         <padding>
            <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
         </padding>
         <children>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showProductos" styleClass="button-primary" text="Productos" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showAlmacenes" styleClass="button-primary" text="Almacenes" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox fx:id="contentArea" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="title" text="Selecciona una opción del menú" />
         </children>
      </VBox>
   </center>
</BorderPane>
