<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.unison.controllers.ProductosController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label styleClass="title" text="Gestión de Productos" />
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefWidth="300.0" spacing="15.0" styleClass="card">
               <children>
                  <Label styleClass="subtitle" text="Detalles del Producto" />
                  <TextField fx:id="txtNombre" promptText="Nombre del Producto" />
                  <TextField fx:id="txtDescripcion" promptText="Descripción" />
                  <TextField fx:id="txtCantidad" promptText="Cantidad" />
                  <TextField fx:id="txtPrecio" promptText="Precio" />
                  <ComboBox fx:id="cmbAlmacen" maxWidth="1.7976931348623157E308" promptText="Seleccionar Almacén" />
                  <Label fx:id="lblError" styleClass="error-label" visible="false" />
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#guardarProducto" styleClass="button-primary" text="Guardar" />
                        <Button mnemonicParsing="false" onAction="#limpiarFormulario" styleClass="button-secondary" text="Limpiar" />
                     </children>
                  </HBox>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminarProducto" style="-fx-background-color: #FF4C4C; -fx-text-fill: white; -fx-background-radius: 25; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;" text="Eliminar Seleccionado" />
               </children>
            </VBox>
            <TableView fx:id="tablaProductos" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                  <TableColumn fx:id="colCantidad" prefWidth="70.0" text="Cant." />
                  <TableColumn fx:id="colPrecio" prefWidth="70.0" text="Precio" />
                  <TableColumn fx:id="colAlmacen" prefWidth="120.0" text="Almacén" />
                  <TableColumn fx:id="colUltimaMod" prefWidth="150.0" text="Última Modificación" />
              </columns>
            </TableView>
         </children>
      </HBox>
   </children>
</VBox>
